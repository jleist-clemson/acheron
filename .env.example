# Copy to `.env` and adjust as needed. `docker compose` reads `.env` automatically.
# Every value here also has a default baked into docker-compose.yml, so the
# stack runs even without this file — it exists for discoverability and overrides.

# --- ports exposed on the host ---
APP_PORT=8000
MONGO_PORT=27017
ES_PORT=9200
REDIS_PORT=6379

# --- MongoDB credentials ---
MONGO_USER=root
MONGO_PASSWORD=example
MONGODB_DB=acheron

# --- Elasticsearch ---
ELASTICSEARCH_INDEX=events

# --- application tunables ---
QUEUE_MAX_SIZE=10000          # max in-flight events buffered in the asyncio queue
WORKER_CONCURRENCY=4          # number of concurrent consumer tasks
WORKER_BATCH_SIZE=100         # events per Mongo bulk write
MAX_RETRIES=5                 # delivery attempts before an event is sent to the DLQ
RETRY_BASE_DELAY_SECONDS=0.5  # base for exponential backoff (0.5, 1, 2, 4, ... + jitter)
REALTIME_CACHE_TTL_SECONDS=15 # TTL for the /events/stats/realtime cache entry
LOG_LEVEL=INFO
